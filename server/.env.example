# Local development values only. Set real values in the host's environment for production.
NODE_ENV=development
PORT=3000
SESSION_SECRET=dev-only-session-secret-not-for-production
SEED_ADMIN_NAME=Dev Admin
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=dev-only-admin-password
# Leave unset locally to use the in-memory database. Required in production.
# MONGODB_URI=
DEMO_FINANCE_EMAIL=finance@example.test
DEMO_FINANCE_PASSWORD=dev-only-finance-password
DEMO_HEAD_EMAIL=head@example.test
DEMO_HEAD_PASSWORD=dev-only-head-password
DEMO_HEAD_DEPARTMENT=PETROLEUM
CRON_SECRET=dev-only-cron-secret
